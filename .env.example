# Copy to .env (never commit .env). Names only — no real values in this file.

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5001/<firebase-project-id>/europe-west1/api/v1

# Backend (local emulators; production values live in Firebase secrets)
FIREBASE_PROJECT_ID=
FUNCTIONS_REGION=europe-west1

# Tests
E2E_BASE_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:5001/<firebase-project-id>/europe-west1/api/v1
